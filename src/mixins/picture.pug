mixin picture(name, alt, width, height, eager = false)
  picture
    source(srcset=`/images/${name}.avif`, type='image/avif')
    source(srcset=`/images/${name}.webp`, type='image/webp')
    if eager
      img(
        src=`/images/${name}.jpg`,
        alt=alt,
        width=width,
        height=height,
        fetchpriority='high',
        decoding='async'
      )&attributes(attributes)
    else
      img(
        src=`/images/${name}.jpg`,
        alt=alt,
        width=width,
        height=height,
        loading='lazy',
        decoding='async'
      )&attributes(attributes)
