include ../../mixins/picture

section.hero
  .hero__bg
    +picture(
      'hero-desktop',
      'Woman wearing silver Bose Noise Cancelling Headphones 700',
      1440,
      720,
      true,
    ).hero__image

  .container.hero__inner
    .hero__content
      img.hero__waves(
        src='images/sound-waves.png',
        alt='',
        width='63',
        height='76',
        aria-hidden='true'
      )
      h1.hero__title
        | The world shades.
        br
        | Your music shines.
