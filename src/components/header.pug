include ../mixins/icon

header#home.header
  input#menu-toggle.menu-toggle.visually-hidden(
    type='checkbox',
    aria-label='Toggle navigation menu'
  )

  .container.header__bar
    a.header__logo(href='#home', aria-label='Bose home')
      img.header__logo-icon(src='images/Logo.svg', alt='Bose', width='190', height='24')

    .header__actions
      a.header__phone(href=siteData.phoneHref, aria-label=`Call us: ${siteData.phoneDisplay}`)
        span.header__phone-number= siteData.phoneDisplay
        +icon('phone', 24, 24)

      label.header__burger(for='menu-toggle')
        span.visually-hidden Open menu
        span.header__burger-line.header__burger-line--top
        span.header__burger-line
        span.header__burger-line.header__burger-line--bottom

  .menu
    .container.menu__inner
      .menu__top
        a.menu__logo(href='#home', aria-label='Bose home')
          img.menu__logo-icon(src='images/Logo.svg', alt='Bose', width='190', height='24')
        label.menu__close(for='menu-toggle')
          span.visually-hidden Close menu
          +icon('close', 24, 24)

      nav.menu__nav(aria-label='Main navigation')
        ul.menu__list
          each item in siteData.nav
            li.menu__item
              a.menu__link(href=item.href)= item.label

      .menu__contacts
        a.menu__phone(href=siteData.phoneHref)= siteData.phoneDisplay
        a.menu__call-link(href=siteData.phoneHref) Call to order
